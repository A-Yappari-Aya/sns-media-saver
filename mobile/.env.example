# Next.js `/api` base (no trailing slash). Emulator defaults are applied in code if unset.
# iOS Simulator: http://127.0.0.1:3000/api
# Android Emulator: http://10.0.2.2:3000/api
# Physical device: http://<your-lan-ip>:3000/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api

# Web origin for 利用規約 / プライバシー (WebBrowser)
EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000

EXPO_PUBLIC_SITE_NAME=メディア保存

# AdMob — leave unset / EXPO_PUBLIC_ADMOB_USE_TEST=1 to use Google sample IDs
EXPO_PUBLIC_ADMOB_USE_TEST=1
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
