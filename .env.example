# Web (Next.js)
WORKER_URL=http://127.0.0.1:4100
NEXT_PUBLIC_SITE_NAME=メディア保存

# Google AdSense (empty = placeholder slots)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=

# Rate limit
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=60

# Timeouts / size
RESOLVE_TIMEOUT_MS=45000
MAX_MEDIA_BYTES=104857600

# Worker
PORT=4100
YT_DLP_PATH=yt-dlp
WORKER_TIMEOUT_MS=40000
MAX_FILESIZE=100M

